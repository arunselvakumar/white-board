/// Identity: Users, Sessions, Companies, members, and invitations (ADR-0034,
/// ADR CM-0002). Construction Management owns this copy; Whiteboard has its
/// own (ADR-0040).
/// Better Auth reads and writes these tables through its Prisma adapter, so
/// field names follow Better Auth and `@map` keeps the columns snake case.
/// Other contexts refer to a User or Workspace only by its opaque id.

model IdentityUser {
  id                  String   @id
  name                String
  email               String   @unique
  emailVerified       Boolean  @default(false) @map("email_verified")
  image               String?
  /// E.164 mobile for OTP sign-in (ADR CM-0002).
  phoneNumber         String?  @unique @map("phone_number")
  phoneNumberVerified Boolean? @map("phone_number_verified")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  sessions    IdentitySession[]
  accounts    IdentityAccount[]
  memberships IdentityWorkspaceMember[]
  invitations IdentityWorkspaceInvitation[]

  @@map("users")
  @@schema("identity")
}

model IdentitySession {
  id                   String   @id
  userId               String   @map("user_id")
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  /// The Active Workspace. Access is still checked against the member row.
  activeOrganizationId String?  @map("active_workspace_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @map("updated_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("identity")
}

/// A way to sign in: `credential` (password) or `google`.
model IdentityAccount {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @map("updated_at")

  user IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
  @@schema("identity")
}

/// Email verification and password reset codes (stored hashed).
model IdentityVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @map("updated_at")

  @@index([identifier])
  @@map("verifications")
  @@schema("identity")
}

/// A Company. Better Auth calls it an organization; `institutionType` is
/// always `construction_company`.
model IdentityWorkspace {
  id              String   @id
  name            String
  slug            String   @unique
  logo            String?
  metadata        String?
  institutionType String   @map("institution_type")
  createdAt       DateTime @map("created_at")

  members     IdentityWorkspaceMember[]
  invitations IdentityWorkspaceInvitation[]

  @@map("workspaces")
  @@schema("identity")
}

/// A User's membership and role (`owner`, `member`).
model IdentityWorkspaceMember {
  id             String   @id
  organizationId String   @map("workspace_id")
  userId         String   @map("user_id")
  role           String
  createdAt      DateTime @map("created_at")

  workspace IdentityWorkspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user      IdentityUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("workspace_members")
  @@schema("identity")
}

model IdentityWorkspaceInvitation {
  id             String   @id
  organizationId String   @map("workspace_id")
  email          String
  role           String?
  /// pending, accepted, rejected, or canceled.
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at")
  inviterId      String   @map("inviter_id")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace IdentityWorkspace @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter   IdentityUser      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("workspace_invitations")
  @@schema("identity")
}

model IdentityRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
  @@schema("identity")
}
