/// Construction Management — labour context (ADR CM-0001, `modules/08`):
/// the Company's own Employees (ADR CM-0055) and labour-supply vendors,
/// daily attendance, and what each is owed. Every amount is integer paise.
/// Balances are never stored: they are the sum of immutable ledger entries
/// (ADR CM-0004). Projects, Roles, Team Members and Labour Categories are
/// ids from other contexts.

enum ConstructionLabourWageType {
  daily
  monthly

  @@map("wage_type")
  @@schema("construction_labour")
}

enum ConstructionLabourGender {
  male
  female
  other

  @@map("gender")
  @@schema("construction_labour")
}

/// An Employee of the Company (ADR CM-0055): one record for everyone who
/// used to be a Labour or a Site Engineer. What sets them apart is their
/// Role (organization context id), and through it the Role's Department.
/// Every Employee has a wage and is on the attendance sheet of the Projects
/// they work on. An Employee may sign in (`team_member_id`): what they may
/// then do comes from the Role's Permission Matrix. Wages here are the
/// current rates; attendance keeps its own snapshot so a change never
/// reprices past days. Aadhaar, PAN and the bank account number are
/// AES-256-GCM ciphertext (shared-kernel `PrivateDataCipher`); the last
/// four characters are kept for masking.
model ConstructionLabourEmployee {
  id                   String                     @id @db.Uuid
  workspaceId          String                     @map("workspace_id")
  name                 String
  /// The Company's own "Employee Id"; unique among live Employees when set.
  employeeCode         String?                    @map("employee_code")
  /// `construction_organization.roles`; live, in the same Company. The
  /// Department is the Role's (`roles.department_id`), never stored here.
  roleId               String                     @map("role_id") @db.Uuid
  /// The sign-in membership (`construction_organization.team_members`),
  /// kept off Office Staff; null when the Employee does not sign in.
  teamMemberId         String?                    @unique @map("team_member_id") @db.Uuid
  fatherName           String?                    @map("father_name")
  dateOfBirth          DateTime?                  @map("date_of_birth") @db.Date
  gender               ConstructionLabourGender?
  /// A+, A-, B+, B-, AB+, AB-, O+ or O-.
  bloodGroup           String?                    @map("blood_group") @db.VarChar(3)
  joiningDate          DateTime                   @map("joining_date") @db.Date
  /// E.164. Required to sign in: it is their login (ADR CM-0053).
  mobile               String?
  email                String?
  address              String?
  emergencyContact     String?                    @map("emergency_contact")
  qualification        String?
  experienceYears      Int?                       @map("experience_years")
  /// Civil, steel / PEB, MEP …; free text.
  specialisation       String?
  wageType             ConstructionLabourWageType @map("wage_type")
  /// Paise; set when `wage_type` is daily.
  wagePerDay           Int?                       @map("wage_per_day")
  /// Paise; set when `wage_type` is monthly.
  wagePerMonth         Int?                       @map("wage_per_month")
  /// Paise.
  overtimeWagePerHour  Int                        @map("overtime_wage_per_hour")
  /// Hours a day; time worked beyond it is overtime (ADR CM-0011).
  workingHoursPerDay   Decimal                    @default(8) @map("working_hours_per_day") @db.Decimal(4, 2)
  /// Weekdays off, 0 = Sunday … 6 = Saturday.
  weeklyHolidays       Int[]                      @map("weekly_holidays")
  uanNumber            String?                    @map("uan_number") @db.VarChar(12)
  esicNumber           String?                    @map("esic_number") @db.VarChar(17)
  aadhaarEncrypted     String?                    @map("aadhaar_encrypted")
  aadhaarLast4         String?                    @map("aadhaar_last4") @db.Char(4)
  panEncrypted         String?                    @map("pan_encrypted")
  panLast4             String?                    @map("pan_last4") @db.Char(4)
  bankAccountHolder    String?                    @map("bank_account_holder")
  bankAccountEncrypted String?                    @map("bank_account_encrypted")
  bankAccountLast4     String?                    @map("bank_account_last4") @db.VarChar(4)
  bankIfsc             String?                    @map("bank_ifsc") @db.VarChar(11)
  bankName             String?                    @map("bank_name")
  /// `construction_masters.labour_categories`: the trade their overtime is
  /// booked under.
  labourCategoryId     String?                    @map("labour_category_id") @db.Uuid
  /// The Employee this Employee reports to, if any (ADR CM-0035, CM-0055):
  /// another live Employee of the same Company, never themselves, never a loop.
  reportsToId          String?                    @map("reports_to_id") @db.Uuid
  /// Storage key; a `stored_files` row.
  photoKey             String?                    @map("photo_key")
  /// Inactive Employees leave the attendance list; their records stay.
  isActive             Boolean                    @default(true) @map("is_active")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy            String                     @map("created_by")
  updatedBy            String                     @map("updated_by")
  deletedAt            DateTime?                  @map("deleted_at") @db.Timestamptz(3)
  deletedBy            String?                    @map("deleted_by")

  reportsTo  ConstructionLabourEmployee?          @relation("EmployeeReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports    ConstructionLabourEmployee[]         @relation("EmployeeReportsTo")
  projects   ConstructionLabourEmployeeProject[]
  transfers  ConstructionLabourEmployeeTransfer[]
  attendance ConstructionLabourAttendance[]

  @@index([workspaceId, name])
  @@index([workspaceId, roleId])
  @@index([reportsToId])
  @@map("employees")
  @@schema("construction_labour")
}

/// The Projects an Employee works on now (ADR CM-0033, CM-0055): none, one
/// or many. Changed from the Project's Teams and by a transfer, each of
/// which also writes an `employee_transfers` row. For an Employee who signs
/// in, the same Projects are their membership's Projects, so they see them.
model ConstructionLabourEmployeeProject {
  workspaceId String   @map("workspace_id")
  employeeId  String   @map("employee_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  /// The first day on the Project.
  since       DateTime @db.Date

  employee ConstructionLabourEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, projectId])
  @@index([workspaceId, projectId])
  @@map("employee_projects")
  @@schema("construction_labour")
}

/// Where an Employee works, from when (CM-206, ADR CM-0033). A row that
/// adds them to a Project has no `from_project_id`; one that takes them
/// off has no `to_project_id`; a transfer has both. An Employee is on a
/// Project on a date when the latest row on or before it that names the
/// Project moves them to it. Append-only.
model ConstructionLabourEmployeeTransfer {
  id            String   @id @db.Uuid
  workspaceId   String   @map("workspace_id")
  employeeId    String   @map("employee_id") @db.Uuid
  fromProjectId String?  @map("from_project_id") @db.Uuid
  toProjectId   String?  @map("to_project_id") @db.Uuid
  /// The first day in the new project (or the first day off the old one).
  transferDate  DateTime @map("transfer_date") @db.Date
  remark        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String   @map("created_by")

  employee ConstructionLabourEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, transferDate])
  @@index([workspaceId, toProjectId])
  @@index([workspaceId, fromProjectId])
  @@map("employee_transfers")
  @@schema("construction_labour")
}

enum ConstructionLabourAttendanceStatus {
  present
  half_day
  absent
  on_leave
  holiday

  @@map("attendance_status")
  @@schema("construction_labour")
}

/// One Employee, one Project, one day (CM-210, ADR CM-0033, CM-0055): one
/// live row per Employee per Project per date (partial unique index in the
/// migration), on a Project they were on that day. The wage is a snapshot;
/// `earned` is what the day pays before overtime. Re-marking a day updates
/// the row and reverses its old ledger entries.
model ConstructionLabourAttendance {
  id               String                             @id @db.Uuid
  workspaceId      String                             @map("workspace_id")
  projectId        String                             @map("project_id") @db.Uuid
  employeeId       String                             @map("employee_id") @db.Uuid
  attendanceDate   DateTime                           @map("attendance_date") @db.Date
  status           ConstructionLabourAttendanceStatus
  /// Only on `on_leave`: the leave day is paid ("Mark Paid Leave").
  isPaidLeave      Boolean                            @default(false) @map("is_paid_leave")
  shift            String?
  /// `HH:MM`, Company time; only on Present or Half Day (ADR CM-0011).
  checkIn          String?                            @map("check_in") @db.Char(5)
  /// `HH:MM`; at or before `check_in` means the next day.
  checkOut         String?                            @map("check_out") @db.Char(5)
  /// Unpaid break in minutes; set when there is a check-in.
  breakMinutes     Int?                               @map("break_minutes")
  /// The Employee's working hours a day, as on the day it was marked.
  workingHours     Decimal                            @default(8) @map("working_hours") @db.Decimal(4, 2)
  wageType         ConstructionLabourWageType         @map("wage_type")
  /// Paise: wage per day, or wage per month, as on the day it was marked.
  wageRate         Int                                @map("wage_rate")
  /// Paise the day pays before overtime.
  earned           Int
  /// The day exists because of a Check-In and the sheet has not saved it
  /// since (ADR CM-0043): voiding its last check-in entry clears it.
  fromCheckIn      Boolean                            @default(false) @map("from_check_in")
  /// The times follow the Check-In log; typing other times turns it off.
  timesFromCheckIn Boolean                            @default(false) @map("times_from_check_in")
  createdAt        DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                           @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy        String                             @map("created_by")
  updatedBy        String                             @map("updated_by")
  deletedAt        DateTime?                          @map("deleted_at") @db.Timestamptz(3)
  deletedBy        String?                            @map("deleted_by")

  employee ConstructionLabourEmployee   @relation(fields: [employeeId], references: [id])
  overtime ConstructionLabourOvertime[]

  @@index([workspaceId, projectId, attendanceDate])
  @@index([employeeId, attendanceDate])
  @@map("employee_attendance")
  @@schema("construction_labour")
}

/// Overtime on an attendance day: hours at a rate, under a Labour Category.
model ConstructionLabourOvertime {
  id               String  @id @db.Uuid
  attendanceId     String  @map("attendance_id") @db.Uuid
  labourCategoryId String? @map("labour_category_id") @db.Uuid
  /// 0 < hours ≤ 24.
  hours            Decimal @db.Decimal(4, 2)
  /// Paise per hour.
  ratePerHour      Int     @map("rate_per_hour")
  /// Paise: hours × rate, rounded half up.
  amount           Int
  /// Hours worked out from check-in, check-out and break (ADR CM-0011).
  fromTimes        Boolean @default(false) @map("from_times")

  attendance ConstructionLabourAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("employee_overtime")
  @@schema("construction_labour")
}

enum ConstructionLabourCheckInPersonKind {
  employee
  vendor

  @@map("check_in_person_kind")
  @@schema("construction_labour")
}

enum ConstructionLabourCheckInAction {
  check_in
  check_out

  @@map("check_in_action")
  @@schema("construction_labour")
}

/// One Check In or Check Out of a person at a Project's site (ADR CM-0043):
/// a photo, the server's time and the device's location. Append-only: a
/// wrong one is voided, and only the retention job removes the photo. An
/// Employee's entries write their attendance day; a Vendor's are a log.
model ConstructionLabourCheckInEvent {
  id             String                              @id @db.Uuid
  workspaceId    String                              @map("workspace_id")
  projectId      String                              @map("project_id") @db.Uuid
  personKind     ConstructionLabourCheckInPersonKind @map("person_kind")
  /// An Employee or a Vendor row, by `person_kind`.
  personId       String                              @map("person_id") @db.Uuid
  action         ConstructionLabourCheckInAction
  /// The server's clock when the entry arrived.
  occurredAt     DateTime                            @map("occurred_at") @db.Timestamptz(3)
  /// Company time zone: today for a Check In; for a Check Out, the day of
  /// the Check In it closes.
  attendanceDate DateTime                            @map("attendance_date") @db.Date
  /// A `stored_files` row; null once the retention job removed the photo.
  photoKey       String?                             @map("photo_key")
  photoRemovedAt DateTime?                           @map("photo_removed_at") @db.Timestamptz(3)
  latitude       Decimal?                            @db.Decimal(9, 6)
  longitude      Decimal?                            @db.Decimal(9, 6)
  /// Metres, as the device reported it.
  accuracyMetres Decimal?                            @map("accuracy_metres") @db.Decimal(8, 2)
  /// Against the Project's Site fence; null without a location or a fence.
  outsideFence   Boolean?                            @map("outside_fence")
  /// 0 inside the fence; set exactly when `outside_fence` is.
  metresOutside  Int?                                @map("metres_outside")
  voidedAt       DateTime?                           @map("voided_at") @db.Timestamptz(3)
  voidedBy       String?                             @map("voided_by")
  voidReason     String?                             @map("void_reason")
  createdAt      DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  /// The member who held the device.
  createdBy      String                              @map("created_by")

  @@index([workspaceId, projectId, attendanceDate, occurredAt])
  @@index([workspaceId, personKind, personId, occurredAt])
  @@map("check_in_events")
  @@schema("construction_labour")
}

/// A labour-supply vendor (gang or contractor) paid per head per shift by
/// Labour Category (CM-208).
model ConstructionLabourVendor {
  id            String    @id @db.Uuid
  workspaceId   String    @map("workspace_id")
  name          String
  joiningDate   DateTime  @map("joining_date") @db.Date
  /// E.164.
  contactNumber String?   @map("contact_number")
  address       String?
  photoKey      String?   @map("photo_key")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy     String    @map("created_by")
  updatedBy     String    @map("updated_by")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy     String?   @map("deleted_by")

  projects   ConstructionLabourVendorProject[]
  shifts     ConstructionLabourVendorShift[]
  attendance ConstructionLabourVendorAttendance[]

  @@index([workspaceId, name])
  @@map("vendors")
  @@schema("construction_labour")
}

/// Projects a vendor supplies labour to.
model ConstructionLabourVendorProject {
  vendorId  String @map("vendor_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid

  vendor ConstructionLabourVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([vendorId, projectId])
  @@index([projectId])
  @@map("vendor_projects")
  @@schema("construction_labour")
}

/// "Shift 1", "Shift 2" … on a vendor's rate card.
model ConstructionLabourVendorShift {
  id        String    @id @db.Uuid
  vendorId  String    @map("vendor_id") @db.Uuid
  name      String
  /// `HH:MM`, 24-hour.
  startTime String?   @map("start_time") @db.Char(5)
  endTime   String?   @map("end_time") @db.Char(5)
  sortOrder Int       @map("sort_order")
  /// A removed shift stays for the attendance that used it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  vendor ConstructionLabourVendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rates  ConstructionLabourVendorRate[]

  @@index([vendorId])
  @@map("vendor_shifts")
  @@schema("construction_labour")
}

/// What a vendor charges per head for one Labour Category on one shift.
model ConstructionLabourVendorRate {
  id               String @id @db.Uuid
  shiftId          String @map("shift_id") @db.Uuid
  labourCategoryId String @map("labour_category_id") @db.Uuid
  /// Paise per head per full day.
  ratePerDay       Int    @map("rate_per_day")
  /// Paise per overtime hour.
  overtimePerHour  Int    @map("overtime_per_hour")

  shift ConstructionLabourVendorShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, labourCategoryId])
  @@map("vendor_rates")
  @@schema("construction_labour")
}

/// One vendor, one Project, one day (CM-212): one live row (partial unique
/// index in the migration) with a line per shift and category.
model ConstructionLabourVendorAttendance {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id")
  projectId      String    @map("project_id") @db.Uuid
  vendorId       String    @map("vendor_id") @db.Uuid
  attendanceDate DateTime  @map("attendance_date") @db.Date
  /// Paise: the sum of the lines.
  totalPay       Int       @map("total_pay")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by")
  updatedBy      String    @map("updated_by")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?   @map("deleted_by")

  vendor ConstructionLabourVendor                 @relation(fields: [vendorId], references: [id])
  lines  ConstructionLabourVendorAttendanceLine[]

  @@index([workspaceId, projectId, attendanceDate])
  @@index([vendorId, attendanceDate])
  @@map("vendor_attendance")
  @@schema("construction_labour")
}

/// Headcount for one shift and category, priced from the rate card as it
/// stood when the line was saved (snapshots).
model ConstructionLabourVendorAttendanceLine {
  id               String  @id @db.Uuid
  attendanceId     String  @map("attendance_id") @db.Uuid
  shiftId          String  @map("shift_id") @db.Uuid
  shiftName        String  @map("shift_name")
  labourCategoryId String  @map("labour_category_id") @db.Uuid
  fullDayCount     Int     @map("full_day_count")
  halfDayCount     Int     @map("half_day_count")
  /// Total overtime hours for the line, not per head.
  overtimeHours    Decimal @default(0) @map("overtime_hours") @db.Decimal(6, 2)
  ratePerDay       Int     @map("rate_per_day")
  overtimePerHour  Int     @map("overtime_per_hour")
  /// Paise: full × rate + half × rate ÷ 2 + overtime hours × overtime rate.
  amount           Int

  attendance ConstructionLabourVendorAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("vendor_attendance_lines")
  @@schema("construction_labour")
}

enum ConstructionLabourPartyType {
  employee
  vendor

  @@map("party_type")
  @@schema("construction_labour")
}

enum ConstructionLabourLedgerEntryKind {
  /// What was owed (positive) or advanced (negative) before the app.
  opening
  /// A day's wage or a vendor day's pay.
  earned
  overtime
  /// Money paid against wages earned.
  payment
  /// Money paid ahead of wages.
  advance

  @@map("ledger_entry_kind")
  @@schema("construction_labour")
}

/// The money trail for an Employee or a vendor (ADR CM-0004). Append-only:
/// a change writes an entry that reverses the old one (`reverses_entry_id`)
/// and a new one. Positive amounts are owed to the party; payments and
/// advances are negative. A balance is the sum of the entries.
model ConstructionLabourLedgerEntry {
  id              String                            @id @db.Uuid
  workspaceId     String                            @map("workspace_id")
  partyType       ConstructionLabourPartyType       @map("party_type")
  partyId         String                            @map("party_id") @db.Uuid
  /// The Project the money is for; null for an opening balance.
  projectId       String?                           @map("project_id") @db.Uuid
  entryDate       DateTime                          @map("entry_date") @db.Date
  kind            ConstructionLabourLedgerEntryKind
  /// Paise, signed.
  amount          Int
  /// What wrote it: `employee`, `vendor`, `employee_attendance`, `vendor_attendance`, `wage_payment`.
  sourceType      String                            @map("source_type")
  sourceId        String                            @map("source_id") @db.Uuid
  reversesEntryId String?                           @unique @map("reverses_entry_id") @db.Uuid
  createdAt       DateTime                          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String                            @map("created_by")

  @@index([workspaceId, partyType, partyId, entryDate])
  @@index([workspaceId, projectId, entryDate])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
  @@schema("construction_labour")
}

enum ConstructionLabourPaymentKind {
  payment
  advance

  @@map("payment_kind")
  @@schema("construction_labour")
}

enum ConstructionLabourPaymentMode {
  cash
  bank

  @@map("payment_mode")
  @@schema("construction_labour")
}

/// Money paid to an Employee or a vendor (CM-215). Posts one ledger entry;
/// cancelling posts its reversal. From M7 a payment names the finance account
/// it was paid from and posts there too (CM-0017 §12).
model ConstructionLabourWagePayment {
  id             String                        @id @db.Uuid
  workspaceId    String                        @map("workspace_id")
  partyType      ConstructionLabourPartyType   @map("party_type")
  partyId        String                        @map("party_id") @db.Uuid
  projectId      String                        @map("project_id") @db.Uuid
  paymentDate    DateTime                      @map("payment_date") @db.Date
  kind           ConstructionLabourPaymentKind
  mode           ConstructionLabourPaymentMode
  /// `construction_finance.accounts`; required from M7, null on older rows.
  accountId      String?                       @map("account_id") @db.Uuid
  reference      String?
  /// Paise, positive.
  amount         Int
  /// The Team Member who handed over the money.
  paidByMemberId String?                       @map("paid_by_member_id") @db.Uuid
  remarks        String?
  /// Storage key of a receipt or voucher; a `stored_files` row.
  documentKey    String?                       @map("document_key")
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                      @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy      String                        @map("created_by")
  updatedBy      String                        @map("updated_by")
  deletedAt      DateTime?                     @map("deleted_at") @db.Timestamptz(3)
  deletedBy      String?                       @map("deleted_by")

  @@index([workspaceId, projectId, paymentDate])
  @@index([workspaceId, partyType, partyId])
  @@map("wage_payments")
  @@schema("construction_labour")
}

enum ConstructionLabourDocumentOwner {
  employee
  vendor

  @@map("document_owner")
  @@schema("construction_labour")
}

/// "Other Documents" on an Employee or a vendor: files in private storage.
model ConstructionLabourDocument {
  id          String                          @id @db.Uuid
  workspaceId String                          @map("workspace_id")
  ownerType   ConstructionLabourDocumentOwner @map("owner_type")
  ownerId     String                          @map("owner_id") @db.Uuid
  /// Storage key; a `stored_files` row.
  fileKey     String                          @unique @map("file_key")
  fileName    String                          @map("file_name")
  contentType String                          @map("content_type")
  bytes       Int
  createdAt   DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String                          @map("created_by")
  deletedAt   DateTime?                       @map("deleted_at") @db.Timestamptz(3)

  @@index([workspaceId, ownerType, ownerId])
  @@map("documents")
  @@schema("construction_labour")
}
