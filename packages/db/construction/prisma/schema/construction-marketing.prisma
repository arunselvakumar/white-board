/// Construction Management — marketing context (ADR CM-0040): Prospect
/// Companies the marketing team visits to win work, their Contacts, the
/// history of their Stage, and Visits with their visitors, points of
/// contact and notes. Follow-ups and visit targets come with their own
/// tickets.
///
/// Conventions:
/// - Team Members live in another schema: `*_member_id` columns are their
///   ids, kept without foreign keys. `created_by` / `updated_by` /
///   `deleted_by` are user ids, as in every other context.
/// - Every table has `workspace_id`, so the Company purge finds it (CM-907).
/// - Rows are soft-deleted (`deleted_at`); "one live name per Company" and
///   "one primary Contact per Prospect Company" are partial unique indexes
///   in the migration.
/// - Mobile numbers are stored normalised (`+91…`).

/// Where a Prospect Company stands (ADR CM-0040 §11). New and Contacted are
/// set by the system; the rest by hand, in any order.
enum ConstructionMarketingStage {
  new
  contacted
  requirement_received
  quotation_sent
  negotiation
  won
  lost

  @@map("stage")
  @@schema("construction_marketing")
}

/// Why a Prospect Company was Lost; `other` needs words.
enum ConstructionMarketingLostReason {
  price
  competitor
  no_requirement
  not_reachable
  other

  @@map("lost_reason")
  @@schema("construction_marketing")
}

/// How the marketing team found the company.
enum ConstructionMarketingCompanySource {
  reference
  cold_call
  tender_notice
  existing_client
  exhibition
  online
  other

  @@map("company_source")
  @@schema("construction_marketing")
}

model ConstructionMarketingProspectCompany {
  id               String                              @id @db.Uuid
  workspaceId      String                              @map("workspace_id")
  name             String
  /// Lower case, spaces collapsed: unique among the Company's live rows.
  nameKey          String                              @map("name_key")
  industry         String?
  address          String?
  city             String?
  /// GST state code (`33` Tamil Nadu); the GSTIN's first two digits when it
  /// has one.
  stateCode        String?                             @map("state_code")
  /// Six digits.
  pin              String?
  /// As typed: an office line or a mobile.
  phone            String?
  email            String?
  website          String?
  /// Upper case, checksum valid.
  gstin            String?
  source           ConstructionMarketingCompanySource?
  /// The Marketing Person chasing it; the creator's Team Member id unless
  /// another is picked.
  assignedMemberId String?                             @map("assigned_member_id") @db.Uuid
  stage            ConstructionMarketingStage          @default(new)
  /// Set while Lost.
  lostReason       ConstructionMarketingLostReason?    @map("lost_reason")
  lostReasonText   String?                             @map("lost_reason_text")
  remarks          String?
  createdAt        DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                            @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy        String                              @map("created_by")
  updatedBy        String                              @map("updated_by")
  deletedAt        DateTime?                           @map("deleted_at") @db.Timestamptz(3)
  deletedBy        String?                             @map("deleted_by")

  contacts     ConstructionMarketingContact[]
  stageChanges ConstructionMarketingStageChange[]
  visits       ConstructionMarketingVisit[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, stage])
  @@index([workspaceId, assignedMemberId])
  @@index([workspaceId, createdBy])
  @@map("prospect_companies")
  @@schema("construction_marketing")
}

/// A person at a Prospect Company. Exactly one live Contact is primary once
/// any exist.
model ConstructionMarketingContact {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id")
  prospectCompanyId String    @map("prospect_company_id") @db.Uuid
  name              String
  jobTitle          String?   @map("job_title")
  /// Normalised: `+91XXXXXXXXXX` or `+` and 8–15 digits.
  mobile            String?
  email             String?
  remarks           String?
  isPrimary         Boolean   @default(false) @map("is_primary")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy         String    @map("created_by")
  updatedBy         String    @map("updated_by")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedBy         String?   @map("deleted_by")

  prospectCompany ConstructionMarketingProspectCompany @relation(fields: [prospectCompanyId], references: [id])
  visits          ConstructionMarketingVisitContact[]

  @@index([workspaceId, prospectCompanyId])
  @@index([workspaceId, mobile])
  @@map("contacts")
  @@schema("construction_marketing")
}

/// Append-only: every Stage a Prospect Company moved to, with who and when.
/// The first row of a company is its creation at New (`from_stage` null).
model ConstructionMarketingStageChange {
  id                String                           @id @db.Uuid
  workspaceId       String                           @map("workspace_id")
  prospectCompanyId String                           @map("prospect_company_id") @db.Uuid
  fromStage         ConstructionMarketingStage?      @map("from_stage")
  toStage           ConstructionMarketingStage       @map("to_stage")
  lostReason        ConstructionMarketingLostReason? @map("lost_reason")
  lostReasonText    String?                          @map("lost_reason_text")
  changedAt         DateTime                         @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedBy         String                           @map("changed_by")

  prospectCompany ConstructionMarketingProspectCompany @relation(fields: [prospectCompanyId], references: [id])

  @@index([workspaceId, prospectCompanyId, changedAt])
  @@map("stage_changes")
  @@schema("construction_marketing")
}

/// Stored Visit states (ADR CM-0040 §7). Missed is a Planned Visit whose
/// time has passed, worked out on read.
enum ConstructionMarketingVisitStatus {
  planned
  completed
  cancelled

  @@map("visit_status")
  @@schema("construction_marketing")
}

enum ConstructionMarketingVisitPurpose {
  cold_call
  introduction
  requirement_discussion
  quotation
  negotiation
  relationship
  payment_follow_up
  other

  @@map("visit_purpose")
  @@schema("construction_marketing")
}

enum ConstructionMarketingInterest {
  hot
  warm
  cold

  @@map("interest")
  @@schema("construction_marketing")
}

/// The kind of work a Visit found a requirement for.
enum ConstructionMarketingWorkType {
  civil
  peb
  steel_fabrication
  shed_erection
  other

  @@map("work_type")
  @@schema("construction_marketing")
}

/// One planned or completed visit to a Prospect Company (PRD §3.4).
model ConstructionMarketingVisit {
  id                    String                             @id @db.Uuid
  workspaceId           String                             @map("workspace_id")
  /// `MV-0001`, from the sequence kernel's `marketing_visit` module.
  number                String
  sequence              Int
  prospectCompanyId     String                             @map("prospect_company_id") @db.Uuid
  /// An instant; entered and shown in the Company time zone.
  visitAt               DateTime                           @map("visit_at") @db.Timestamptz(3)
  status                ConstructionMarketingVisitStatus   @default(planned)
  purpose               ConstructionMarketingVisitPurpose?
  location              String?
  discussion            String?
  outcome               String?
  interest              ConstructionMarketingInterest?
  requirementWorkType   ConstructionMarketingWorkType?     @map("requirement_work_type")
  /// Approximate value in whole rupees.
  requirementValue      BigInt?                            @map("requirement_value")
  /// The first day of the month the work is expected to start.
  requirementStartMonth DateTime?                          @map("requirement_start_month") @db.Date
  /// When it was marked Completed; the edit lock counts from it.
  completedAt           DateTime?                          @map("completed_at") @db.Timestamptz(3)
  completedBy           String?                            @map("completed_by")
  cancelReason          String?                            @map("cancel_reason")
  cancelledAt           DateTime?                          @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy           String?                            @map("cancelled_by")
  createdAt             DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                           @default(now()) @map("updated_at") @db.Timestamptz(3)
  createdBy             String                             @map("created_by")
  updatedBy             String                             @map("updated_by")
  deletedAt             DateTime?                          @map("deleted_at") @db.Timestamptz(3)
  deletedBy             String?                            @map("deleted_by")

  prospectCompany ConstructionMarketingProspectCompany @relation(fields: [prospectCompanyId], references: [id])
  visitors        ConstructionMarketingVisitVisitor[]
  contacts        ConstructionMarketingVisitContact[]
  notes           ConstructionMarketingVisitNote[]

  @@unique([workspaceId, number])
  @@index([workspaceId, visitAt])
  @@index([workspaceId, prospectCompanyId, visitAt])
  @@index([workspaceId, createdBy])
  @@map("visits")
  @@schema("construction_marketing")
}

/// A Marketing Person on a Visit (a Team Member id).
model ConstructionMarketingVisitVisitor {
  workspaceId String @map("workspace_id")
  visitId     String @map("visit_id") @db.Uuid
  memberId    String @map("member_id") @db.Uuid

  visit ConstructionMarketingVisit @relation(fields: [visitId], references: [id])

  @@id([visitId, memberId])
  @@index([workspaceId, memberId])
  @@map("visit_visitors")
  @@schema("construction_marketing")
}

/// A point of contact met on a Visit.
model ConstructionMarketingVisitContact {
  workspaceId String @map("workspace_id")
  visitId     String @map("visit_id") @db.Uuid
  contactId   String @map("contact_id") @db.Uuid

  visit   ConstructionMarketingVisit   @relation(fields: [visitId], references: [id])
  contact ConstructionMarketingContact @relation(fields: [contactId], references: [id])

  @@id([visitId, contactId])
  @@index([workspaceId, contactId])
  @@map("visit_contacts")
  @@schema("construction_marketing")
}

/// Append-only: a dated note added after a Visit, never edited.
model ConstructionMarketingVisitNote {
  id          String   @id @db.Uuid
  workspaceId String   @map("workspace_id")
  visitId     String   @map("visit_id") @db.Uuid
  text        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String   @map("created_by")

  visit ConstructionMarketingVisit @relation(fields: [visitId], references: [id])

  @@index([workspaceId, visitId, createdAt])
  @@map("visit_notes")
  @@schema("construction_marketing")
}
