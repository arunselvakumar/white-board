/// Construction Management's own client (ADR-0040). It is generated inside
/// this package so it never overwrites Whiteboard's client.
generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/client"
  // Production builds run on GitHub's Ubuntu runners (ADR-0046) but serve
  // from Vercel's Amazon Linux functions, so the client must also carry the
  // RHEL query engine; "native" alone ships only the runner's Debian one.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

/// One Postgres schema per bounded context (ADR-0030, ADR CM-0001). `public`
/// holds only `_prisma_migrations`.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "construction_organization", "construction_masters", "construction_projects", "construction_labour", "construction_reporting", "construction_hrms", "construction_procurement", "construction_site_work", "construction_finance", "construction_tracking", "construction_messaging", "construction_sales"]
}
