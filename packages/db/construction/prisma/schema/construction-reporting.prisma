/// Construction Management — reporting context (ADR CM-0001, `modules/11`):
/// report jobs and the files they produce. Reports read other contexts'
/// tables (a read model); this schema holds only the jobs. A job runs on
/// the kernel's Postgres queue (ADR CM-0021 §1).

enum ConstructionReportingReportKind {
  labour_attendance
  labour_payment
  labour_month
  vendor_attendance
  muster_roll
  /// Site work (CM-0016 §15, §16).
  daily_progress_report
  daily_work
  owned_equipment_usage
  rented_equipment_usage
  equipment_maintenance
  equipment_transfers
  /// Finance (CM-0017 §16).
  account_ledger
  petty_cash
  transactions
  contractor_payments
  supplier_payments
  other_expenses
  tds_194c
  due_payments
  /// Tracking (CM-0019 §14).
  task_report
  issue_snag_report
  inspection_request_report
  task_progress_report
  /// Procurement and central labour (CM-903, ADR CM-0021 §5).
  purchase_requests
  purchase_orders
  material_received
  material_transfers
  stock_register
  labour_attendance_central

  @@map("report_kind")
  @@schema("construction_reporting")
}

enum ConstructionReportingJobStatus {
  queued
  running
  done
  failed
  /// Its files were deleted by retention (ADR CM-0021 §3).
  expired

  @@map("job_status")
  @@schema("construction_reporting")
}

/// One requested report (CM-217, CM-218): queued → running → done | failed.
/// A done job points at an Excel and a PDF in private storage (each a
/// `stored_files` row of kind `report`); a failed job keeps the message.
model ConstructionReportingReportJob {
  id            String                          @id @db.Uuid
  workspaceId   String                          @map("workspace_id")
  /// Null for a central (all-projects) report.
  projectId     String?                         @map("project_id") @db.Uuid
  kind          ConstructionReportingReportKind
  /// The filters the report was asked for (period, vendor, category, …).
  params        Json
  status        ConstructionReportingJobStatus  @default(queued)
  /// The files carry amounts: downloading needs Financial on the menu.
  includesMoney Boolean                         @default(false) @map("includes_money")
  xlsxKey       String?                         @map("xlsx_key")
  pdfKey        String?                         @map("pdf_key")
  /// Download name without extension, e.g. `muster-roll-2026-09`.
  fileName      String?                         @map("file_name")
  /// Why a failed job failed, in words a screen can show (no stack).
  error         String?
  requestedBy   String                          @map("requested_by")
  createdAt     DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?                       @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?                       @map("finished_at") @db.Timestamptz(3)

  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, requestedBy, createdAt])
  @@map("report_jobs")
  @@schema("construction_reporting")
}

enum ConstructionReportingBackupScope {
  /// One Project's chosen modules (Project → Backup).
  project
  /// The Company's master records (Masters → Backup).
  masters
  /// Everything; Owner only, behind a code (ADR CM-0021 §8).
  company
  /// One user's own data across Companies (Download My Data).
  my_data

  @@map("backup_scope")
  @@schema("construction_reporting")
}

/// One requested backup or data export (CM-906): queued → running → done |
/// failed, then expired after 7 days. It runs as one queue job per module
/// part plus a zip step; `parts` records each part's object and row counts.
model ConstructionReportingBackupJob {
  id            String                           @id @db.Uuid
  /// Null for Download My Data, which spans Companies.
  workspaceId   String?                          @map("workspace_id")
  projectId     String?                          @map("project_id") @db.Uuid
  scope         ConstructionReportingBackupScope
  /// Module keys chosen (e.g. `site_work.daily_worksheet`); empty for my_data.
  modules       String[]
  /// Inclusive period, null for "all time".
  fromDate      DateTime?                        @map("from_date") @db.Date
  toDate        DateTime?                        @map("to_date") @db.Date
  includeData   Boolean                          @default(true) @map("include_data")
  includeMedia  Boolean                          @default(false) @map("include_media")
  /// Amounts are written only when the requester may see them.
  includesMoney Boolean                          @default(false) @map("includes_money")
  status        ConstructionReportingJobStatus   @default(queued)
  /// [{ module, key, rows, bytes, done }] as each part finishes.
  parts         Json                             @default("[]")
  fileKey       String?                          @map("file_key")
  fileName      String?                          @map("file_name")
  bytes         BigInt?
  error         String?
  requestedBy   String                           @map("requested_by")
  createdAt     DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?                        @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?                        @map("finished_at") @db.Timestamptz(3)
  /// The signed link stops working, and retention deletes the file, here.
  expiresAt     DateTime?                        @map("expires_at") @db.Timestamptz(3)

  @@index([workspaceId, requestedBy, createdAt])
  @@index([requestedBy, createdAt])
  @@map("backup_jobs")
  @@schema("construction_reporting")
}
