enum TrainingInstituteClassMode {
  offline
  online
  hybrid

  @@map("class_mode")
  @@schema("training_institute")
}

enum TrainingInstituteMeetingOption {
  external
  whiteboard

  @@map("meeting_option")
  @@schema("training_institute")
}

enum TrainingInstituteClassChangeKind {
  cancelled
  moved

  @@map("class_change_kind")
  @@schema("training_institute")
}

enum TrainingInstituteTimingSource {
  batch
  student

  @@map("timing_source")
  @@schema("training_institute")
}

enum TrainingInstituteFeePlanType {
  one_time
  monthly
  installments

  @@map("fee_plan_type")
  @@schema("training_institute")
}

enum TrainingInstituteFeePaymentMethod {
  cash
  upi
  card
  other

  @@map("fee_payment_method")
  @@schema("training_institute")
}

enum TrainingInstituteCourseDurationKind {
  fixed
  flexible

  @@map("course_duration_kind")
  @@schema("training_institute")
}

enum TrainingInstituteCourseDurationUnit {
  days
  weeks
  months

  @@map("course_duration_unit")
  @@schema("training_institute")
}

enum TrainingInstituteTeacherKind {
  centre_teacher
  visiting_tutor

  @@map("teacher_kind")
  @@schema("training_institute")
}

enum TrainingInstituteTeacherInvitationStatus {
  not_sent
  sent
  failed
  accepted

  @@map("teacher_invitation_status")
  @@schema("training_institute")
}

enum TrainingInstituteAttendanceStatus {
  unmarked
  present
  absent
  late
  excused

  @@map("attendance_status")
  @@schema("training_institute")
}

model TrainingInstituteCourse {
  id                    String                               @id @db.Uuid
  workspaceId           String                               @map("workspace_id")
  createdByUserId       String                               @map("created_by_user_id")
  name                  String                               @db.VarChar(200)
  durationKind          TrainingInstituteCourseDurationKind  @default(flexible) @map("duration_kind")
  durationValue         Int?                                 @map("duration_value")
  durationUnit          TrainingInstituteCourseDurationUnit? @map("duration_unit")
  code                  String?                              @db.VarChar(40)
  category              String?                              @db.VarChar(100)
  totalLearningHours    Int?                                 @map("total_learning_hours")
  eligibility           String?                              @db.Text
  learningOutcomes      String[]                             @default([]) @map("learning_outcomes")
  syllabusOutline       String[]                             @default([]) @map("syllabus_outline")
  description           String?                              @db.Text
  defaultFeeAmountPaise Int                                  @map("default_fee_amount_paise")
  archivedAt            DateTime?                            @map("archived_at")
  archivedByUserId      String?                              @map("archived_by_user_id")
  createdAt             DateTime                             @default(now()) @map("created_at")
  updatedAt             DateTime                             @updatedAt @map("updated_at")
  deletedAt             DateTime?                            @map("deleted_at")
  deletedByUserId       String?                              @map("deleted_by_user_id")

  batches     TrainingInstituteBatch[]
  enrollments TrainingInstituteEnrollment[]
  enquiries   TrainingInstituteEnquiry[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@map("courses")
  @@schema("training_institute")
}

model TrainingInstituteBatch {
  id              String                         @id @db.Uuid
  workspaceId     String                         @map("workspace_id")
  courseId        String                         @map("course_id") @db.Uuid
  createdByUserId String                         @map("created_by_user_id")
  name            String                         @db.VarChar(200)
  classMode       TrainingInstituteClassMode     @map("class_mode")
  capacity        Int
  room            String?                        @db.VarChar(80)
  joinUrl         String?                        @map("join_url") @db.VarChar(2048)
  meetingOption   TrainingInstituteMeetingOption @default(external) @map("meeting_option")
  /// Weekly slots: { daysOfWeek: number[], startTime: "HH:mm", endTime: "HH:mm" }[]
  timings         Json
  timezone        String                         @default("Asia/Kolkata") @db.VarChar(64)
  closedAt        DateTime?                      @map("closed_at")
  closedByUserId  String?                        @map("closed_by_user_id")
  createdAt       DateTime                       @default(now()) @map("created_at")
  updatedAt       DateTime                       @updatedAt @map("updated_at")
  deletedAt       DateTime?                      @map("deleted_at")
  deletedByUserId String?                        @map("deleted_by_user_id")

  course              TrainingInstituteCourse                   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  enrollments         TrainingInstituteEnrollment[]
  teacherAssignments  TrainingInstituteBatchTeacherAssignment[]
  attendanceRegisters TrainingInstituteAttendanceRegister[]
  classOccurrences    TrainingInstituteClassOccurrence[]
  classChanges        TrainingInstituteClassChange[]
  enquiryDemos        TrainingInstituteEnquiryDemo[]
  studyMaterials      TrainingInstituteStudyMaterial[]
  homework            TrainingInstituteHomework[]
  classTests          TrainingInstituteClassTest[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([courseId, deletedAt])
  @@map("batches")
  @@schema("training_institute")
}

model TrainingInstituteClassOccurrence {
  id                 String    @id @db.Uuid
  workspaceId        String    @map("workspace_id")
  batchId            String    @map("batch_id") @db.Uuid
  classDate          DateTime  @map("class_date") @db.Date
  startTime          String    @map("start_time") @db.VarChar(5)
  endTime            String    @map("end_time") @db.VarChar(5)
  providerMeetingId  String?   @unique @map("provider_meeting_id") @db.VarChar(100)
  status             String    @default("starting") @db.VarChar(20)
  recordingId        String?   @map("recording_id") @db.VarChar(100)
  recordingStatus    String    @default("pending") @map("recording_status") @db.VarChar(20)
  recordingObjectKey String?   @map("recording_object_key") @db.VarChar(1024)
  startedByUserId    String    @map("started_by_user_id")
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")

  batch TrainingInstituteBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, classDate, startTime])
  @@index([workspaceId, batchId, classDate])
  @@map("class_occurrences")
  @@schema("training_institute")
}

/// One active change per original Class (Batch, local date, start time). See ADR-0028.
model TrainingInstituteClassChange {
  id               String                           @id @db.Uuid
  workspaceId      String                           @map("workspace_id")
  batchId          String                           @map("batch_id") @db.Uuid
  classDate        DateTime                         @map("class_date") @db.Date
  startTime        String                           @map("start_time") @db.VarChar(5)
  endTime          String                           @map("end_time") @db.VarChar(5)
  kind             TrainingInstituteClassChangeKind
  reason           String?                          @db.VarChar(200)
  movedToDate      DateTime?                        @map("moved_to_date") @db.Date
  movedToStartTime String?                          @map("moved_to_start_time") @db.VarChar(5)
  movedToEndTime   String?                          @map("moved_to_end_time") @db.VarChar(5)
  createdByUserId  String                           @map("created_by_user_id")
  updatedByUserId  String                           @map("updated_by_user_id")
  createdAt        DateTime                         @default(now()) @map("created_at")
  updatedAt        DateTime                         @updatedAt @map("updated_at")
  deletedAt        DateTime?                        @map("deleted_at")
  deletedByUserId  String?                          @map("deleted_by_user_id")

  batch TrainingInstituteBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([workspaceId, batchId, classDate])
  @@index([workspaceId, deletedAt, classDate])
  @@map("class_changes")
  @@schema("training_institute")
}

/// Workspace-wide dates on which every Class is cancelled. See ADR-0028.
model TrainingInstituteHoliday {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id")
  startDate       DateTime  @map("start_date") @db.Date
  endDate         DateTime  @map("end_date") @db.Date
  reason          String?   @db.VarChar(200)
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  @@index([workspaceId, deletedAt, startDate])
  @@map("holidays")
  @@schema("training_institute")
}

model TrainingInstituteTeacher {
  id                   String                                   @id @db.Uuid
  workspaceId          String                                   @map("workspace_id")
  createdByUserId      String                                   @map("created_by_user_id")
  name                 String                                   @db.VarChar(200)
  email                String                                   @db.VarChar(320)
  kind                 TrainingInstituteTeacherKind
  phone                String?                                  @db.VarChar(32)
  qualificationSummary String?                                  @map("qualification_summary") @db.VarChar(1000)
  profileDetails       Json                                     @default("{}") @map("profile_details")
  photoData            Bytes?                                   @map("photo_data")
  photoMimeType        String?                                  @map("photo_mime_type") @db.VarChar(50)
  photoUpdatedAt       DateTime?                                @map("photo_updated_at")
  idNumberEncrypted    String?                                  @map("id_number_encrypted") @db.Text
  idNumberLast4        String?                                  @map("id_number_last4") @db.VarChar(4)
  bankAccountEncrypted String?                                  @map("bank_account_encrypted") @db.Text
  bankAccountLast4     String?                                  @map("bank_account_last4") @db.VarChar(4)
  userId               String?                                  @map("user_id")
  invitationId         String?                                  @map("invitation_id")
  invitationStatus     TrainingInstituteTeacherInvitationStatus @default(not_sent) @map("invitation_status")
  deactivatedAt        DateTime?                                @map("deactivated_at")
  deactivatedByUserId  String?                                  @map("deactivated_by_user_id")
  createdAt            DateTime                                 @default(now()) @map("created_at")
  updatedAt            DateTime                                 @updatedAt @map("updated_at")
  deletedAt            DateTime?                                @map("deleted_at")
  deletedByUserId      String?                                  @map("deleted_by_user_id")

  batchAssignments  TrainingInstituteBatchTeacherAssignment[]
  documents         TrainingInstituteTeacherDocument[]
  enquiryDemos      TrainingInstituteEnquiryDemo[]
  studyMaterials    TrainingInstituteStudyMaterial[]
  homework          TrainingInstituteHomework[]
  classTests        TrainingInstituteClassTest[]
  testResultChanges TrainingInstituteTestResultChange[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([workspaceId, userId])
  @@map("teachers")
  @@schema("training_institute")
}

model TrainingInstituteTeacherDocument {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id")
  teacherId        String    @map("teacher_id") @db.Uuid
  kind             String    @db.VarChar(32)
  name             String    @db.VarChar(200)
  mimeType         String    @map("mime_type") @db.VarChar(50)
  encryptedData    Bytes     @map("encrypted_data")
  sizeBytes        Int       @map("size_bytes")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  uploadedByUserId String    @map("uploaded_by_user_id")
  deletedAt        DateTime? @map("deleted_at")
  deletedByUserId  String?   @map("deleted_by_user_id")

  teacher TrainingInstituteTeacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([workspaceId, teacherId, deletedAt, uploadedAt, id])
  @@map("teacher_documents")
  @@schema("training_institute")
}

model TrainingInstituteBatchTeacherAssignment {
  id                 String    @id @db.Uuid
  workspaceId        String    @map("workspace_id")
  teacherId          String    @map("teacher_id") @db.Uuid
  batchId            String    @map("batch_id") @db.Uuid
  assignedByUserId   String    @map("assigned_by_user_id")
  assignedAt         DateTime  @default(now()) @map("assigned_at")
  unassignedAt       DateTime? @map("unassigned_at")
  unassignedByUserId String?   @map("unassigned_by_user_id")
  deletedAt          DateTime? @map("deleted_at")
  deletedByUserId    String?   @map("deleted_by_user_id")

  teacher TrainingInstituteTeacher @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  batch   TrainingInstituteBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([workspaceId, teacherId, unassignedAt])
  @@index([workspaceId, batchId, unassignedAt])
  @@map("batch_teacher_assignments")
  @@schema("training_institute")
}

model TrainingInstituteStudent {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id")
  createdByUserId String    @map("created_by_user_id")
  name            String    @db.VarChar(200)
  phone           String    @db.VarChar(32)
  email           String?   @db.VarChar(320)
  photoUrl        String?   @map("photo_url") @db.VarChar(2048)
  address         String?   @db.Text
  idProofNote     String?   @map("id_proof_note") @db.Text
  guardianName    String?   @map("guardian_name") @db.VarChar(200)
  guardianPhone   String?   @map("guardian_phone") @db.VarChar(32)
  profileDetails  Json      @default("{}") @map("profile_details")
  droppedAt       DateTime? @map("dropped_at")
  droppedByUserId String?   @map("dropped_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  enrollments          TrainingInstituteEnrollment[]
  attendanceMarks      TrainingInstituteAttendanceMark[]
  convertedFromEnquiry TrainingInstituteEnquiry?
  homeworkSubmissions  TrainingInstituteHomeworkSubmission[]
  classTests           TrainingInstituteClassTest[]
  testResults          TrainingInstituteTestResult[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([workspaceId, phone])
  @@index([workspaceId, name])
  @@map("students")
  @@schema("training_institute")
}

model TrainingInstituteEnrollment {
  id                      String                        @id @db.Uuid
  workspaceId             String                        @map("workspace_id")
  studentId               String                        @map("student_id") @db.Uuid
  courseId                String                        @map("course_id") @db.Uuid
  batchId                 String                        @map("batch_id") @db.Uuid
  createdByUserId         String                        @map("created_by_user_id")
  classModeOverride       TrainingInstituteClassMode?   @map("class_mode_override")
  timingSource            TrainingInstituteTimingSource @map("timing_source")
  /// Student-specific slots when timingSource is student. Same shape as Batch.timings.
  studentTimings          Json?                         @map("student_timings")
  endedAt                 DateTime?                     @map("ended_at")
  endedByUserId           String?                       @map("ended_by_user_id")
  feePlanType             TrainingInstituteFeePlanType  @map("fee_plan_type")
  feePlanAmountPaise      Int                           @map("fee_plan_amount_paise")
  feePlanInstallmentCount Int?                          @map("fee_plan_installment_count")
  feePlanConcessionPaise  Int                           @default(0) @map("fee_plan_concession_paise")
  /// [{ dueOn: "YYYY-MM-DD", amountPaise: number }]
  feePlanDueDates         Json                          @map("fee_plan_due_dates")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  deletedAt               DateTime?                     @map("deleted_at")
  deletedByUserId         String?                       @map("deleted_by_user_id")

  student                TrainingInstituteStudent          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course                 TrainingInstituteCourse           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batch                  TrainingInstituteBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  feePayments            TrainingInstituteFeePayment[]
  attendanceMarks        TrainingInstituteAttendanceMark[]
  convertedFromEnquiries TrainingInstituteEnquiry[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([studentId, deletedAt])
  @@index([batchId, deletedAt, endedAt])
  @@map("enrollments")
  @@schema("training_institute")
}

model TrainingInstituteAttendanceRegister {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id")
  batchId         String    @map("batch_id") @db.Uuid
  date            DateTime  @db.Date
  timezone        String    @db.VarChar(64)
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id")

  batch TrainingInstituteBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  marks TrainingInstituteAttendanceMark[]

  @@index([workspaceId, batchId, date])
  @@map("attendance_registers")
  @@schema("training_institute")
}

model TrainingInstituteAttendanceMark {
  id                  String                            @id @db.Uuid
  workspaceId         String                            @map("workspace_id")
  registerId          String                            @map("register_id") @db.Uuid
  enrollmentId        String                            @map("enrollment_id") @db.Uuid
  studentId           String                            @map("student_id") @db.Uuid
  studentNameSnapshot String                            @map("student_name_snapshot") @db.VarChar(200)
  status              TrainingInstituteAttendanceStatus @default(unmarked)
  note                String?                           @db.VarChar(500)
  markedByUserId      String?                           @map("marked_by_user_id")
  markedAt            DateTime?                         @map("marked_at")
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")
  deletedAt           DateTime?                         @map("deleted_at")
  deletedByUserId     String?                           @map("deleted_by_user_id")

  register   TrainingInstituteAttendanceRegister     @relation(fields: [registerId], references: [id], onDelete: Restrict)
  enrollment TrainingInstituteEnrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  student    TrainingInstituteStudent                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  changes    TrainingInstituteAttendanceMarkChange[]

  @@unique([registerId, enrollmentId])
  @@index([workspaceId, studentId, createdAt])
  @@map("attendance_marks")
  @@schema("training_institute")
}

model TrainingInstituteAttendanceMarkChange {
  id              String                            @id @db.Uuid
  markId          String                            @map("mark_id") @db.Uuid
  oldStatus       TrainingInstituteAttendanceStatus @map("old_status")
  newStatus       TrainingInstituteAttendanceStatus @map("new_status")
  oldNote         String?                           @map("old_note") @db.VarChar(500)
  newNote         String?                           @map("new_note") @db.VarChar(500)
  changedByUserId String                            @map("changed_by_user_id")
  changedAt       DateTime                          @default(now()) @map("changed_at")

  mark TrainingInstituteAttendanceMark @relation(fields: [markId], references: [id], onDelete: Restrict)

  @@index([markId, changedAt])
  @@map("attendance_mark_changes")
  @@schema("training_institute")
}

model TrainingInstituteFeePayment {
  id               String                            @id @db.Uuid
  workspaceId      String                            @map("workspace_id")
  enrollmentId     String                            @map("enrollment_id") @db.Uuid
  recordedByUserId String                            @map("recorded_by_user_id")
  amountPaise      Int                               @map("amount_paise")
  method           TrainingInstituteFeePaymentMethod
  paidAt           DateTime                          @map("paid_at")
  receiptNumber    String                            @map("receipt_number") @db.VarChar(32)
  createdAt        DateTime                          @default(now()) @map("created_at")
  updatedAt        DateTime                          @updatedAt @map("updated_at")
  deletedAt        DateTime?                         @map("deleted_at")
  deletedByUserId  String?                           @map("deleted_by_user_id")

  enrollment TrainingInstituteEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, receiptNumber])
  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([enrollmentId, deletedAt, paidAt, id])
  @@map("fee_payments")
  @@schema("training_institute")
}

enum TrainingInstituteEnquiryStage {
  new
  follow_up
  demo_scheduled
  demo_attended
  joined
  not_interested

  @@map("enquiry_stage")
  @@schema("training_institute")
}

enum TrainingInstituteEnquiryActivityKind {
  created
  follow_up
  not_interested
  reopened
  joined
  details_updated

  @@map("enquiry_activity_kind")
  @@schema("training_institute")
}

enum TrainingInstituteDemoKind {
  batch
  one_to_one

  @@map("demo_kind")
  @@schema("training_institute")
}

enum TrainingInstituteDemoFeeKind {
  free
  paid

  @@map("demo_fee_kind")
  @@schema("training_institute")
}

enum TrainingInstituteDemoAttendance {
  unmarked
  attended
  missed

  @@map("demo_attendance")
  @@schema("training_institute")
}

/// Where Enquiries come from. Names are unique among a Workspace's active
/// Sources, ignoring case (partial unique index in the migration).
model TrainingInstituteEnquirySource {
  id              String    @id @db.Uuid
  workspaceId     String    @map("workspace_id")
  name            String    @db.VarChar(80)
  retiredAt       DateTime? @map("retired_at")
  retiredByUserId String?   @map("retired_by_user_id")
  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  enquiries TrainingInstituteEnquiry[]

  @@index([workspaceId, retiredAt])
  @@map("enquiry_sources")
  @@schema("training_institute")
}

/// A prospect asking about a Course or subject before admission. Not a Student.
model TrainingInstituteEnquiry {
  id                    String                        @id @db.Uuid
  workspaceId           String                        @map("workspace_id")
  createdByUserId       String                        @map("created_by_user_id")
  prospectName          String                        @map("prospect_name") @db.VarChar(200)
  phone                 String                        @db.VarChar(32)
  email                 String?                       @db.VarChar(320)
  guardianName          String?                       @map("guardian_name") @db.VarChar(200)
  guardianPhone         String?                       @map("guardian_phone") @db.VarChar(32)
  courseId              String?                       @map("course_id") @db.Uuid
  subject               String?                       @db.VarChar(200)
  preferredClassMode    TrainingInstituteClassMode?   @map("preferred_class_mode")
  preferredTiming       String?                       @map("preferred_timing") @db.VarChar(200)
  sourceId              String?                       @map("source_id") @db.Uuid
  notes                 String?                       @db.Text
  /// Worked out by the domain on every change; stored so lists can filter.
  stage                 TrainingInstituteEnquiryStage @default(new)
  nextFollowUpOn        DateTime?                     @map("next_follow_up_on") @db.Date
  notInterestedReason   String?                       @map("not_interested_reason") @db.VarChar(200)
  closedAt              DateTime?                     @map("closed_at")
  closedByUserId        String?                       @map("closed_by_user_id")
  convertedStudentId    String?                       @unique @map("converted_student_id") @db.Uuid
  convertedEnrollmentId String?                       @map("converted_enrollment_id") @db.Uuid
  convertedAt           DateTime?                     @map("converted_at")
  convertedByUserId     String?                       @map("converted_by_user_id")
  createdAt             DateTime                      @default(now()) @map("created_at")
  updatedAt             DateTime                      @updatedAt @map("updated_at")
  deletedAt             DateTime?                     @map("deleted_at")
  deletedByUserId       String?                       @map("deleted_by_user_id")

  course              TrainingInstituteCourse?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  source              TrainingInstituteEnquirySource?    @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  convertedStudent    TrainingInstituteStudent?          @relation(fields: [convertedStudentId], references: [id], onDelete: Restrict)
  convertedEnrollment TrainingInstituteEnrollment?       @relation(fields: [convertedEnrollmentId], references: [id], onDelete: Restrict)
  activities          TrainingInstituteEnquiryActivity[]
  demos               TrainingInstituteEnquiryDemo[]

  @@index([workspaceId, deletedAt, createdAt, id])
  @@index([workspaceId, stage, nextFollowUpOn])
  @@index([workspaceId, phone])
  @@map("enquiries")
  @@schema("training_institute")
}

model TrainingInstituteEnquiryActivity {
  id              String                               @id @db.Uuid
  workspaceId     String                               @map("workspace_id")
  enquiryId       String                               @map("enquiry_id") @db.Uuid
  kind            TrainingInstituteEnquiryActivityKind
  note            String?                              @db.VarChar(1000)
  nextFollowUpOn  DateTime?                            @map("next_follow_up_on") @db.Date
  createdByUserId String                               @map("created_by_user_id")
  createdAt       DateTime                             @default(now()) @map("created_at")

  enquiry TrainingInstituteEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@map("enquiry_activities")
  @@schema("training_institute")
}

/// A trial class for an Enquiry's prospect: one date's Class of a Batch, or a
/// one-to-one slot with a Teacher. Never takes a seat or appears in Attendance.
model TrainingInstituteEnquiryDemo {
  id                       String                          @id @db.Uuid
  workspaceId              String                          @map("workspace_id")
  enquiryId                String                          @map("enquiry_id") @db.Uuid
  kind                     TrainingInstituteDemoKind
  batchId                  String?                         @map("batch_id") @db.Uuid
  teacherId                String?                         @map("teacher_id") @db.Uuid
  demoDate                 DateTime                        @map("demo_date") @db.Date
  startTime                String                          @map("start_time") @db.VarChar(5)
  endTime                  String                          @map("end_time") @db.VarChar(5)
  timezone                 String                          @db.VarChar(64)
  feeKind                  TrainingInstituteDemoFeeKind    @map("fee_kind")
  feeAmountPaise           Int?                            @map("fee_amount_paise")
  feePaidAt                DateTime?                       @map("fee_paid_at")
  feePaidByUserId          String?                         @map("fee_paid_by_user_id")
  attendance               TrainingInstituteDemoAttendance @default(unmarked)
  attendanceMarkedAt       DateTime?                       @map("attendance_marked_at")
  attendanceMarkedByUserId String?                         @map("attendance_marked_by_user_id")
  cancelledAt              DateTime?                       @map("cancelled_at")
  cancelledByUserId        String?                         @map("cancelled_by_user_id")
  createdByUserId          String                          @map("created_by_user_id")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")

  enquiry TrainingInstituteEnquiry  @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  batch   TrainingInstituteBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  teacher TrainingInstituteTeacher? @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([workspaceId, demoDate])
  @@index([workspaceId, teacherId, demoDate])
  @@index([enquiryId])
  @@map("enquiry_demos")
  @@schema("training_institute")
}

enum TrainingInstitutePosterRole {
  owner
  teacher

  @@map("poster_role")
  @@schema("training_institute")
}

enum TrainingInstituteSubmitterRole {
  student
  parent

  @@map("submitter_role")
  @@schema("training_institute")
}

/// Notes, a link, or files shared with a Batch (ADR-0033). Removing hides it
/// from Teachers and families; the Owner still sees it.
model TrainingInstituteStudyMaterial {
  id                String                      @id @db.Uuid
  workspaceId       String                      @map("workspace_id")
  batchId           String                      @map("batch_id") @db.Uuid
  title             String                      @db.VarChar(200)
  note              String?                     @db.Text
  linkUrl           String?                     @map("link_url") @db.VarChar(2048)
  classDate         DateTime?                   @map("class_date") @db.Date
  postedByUserId    String                      @map("posted_by_user_id")
  postedByRole      TrainingInstitutePosterRole @map("posted_by_role")
  postedByTeacherId String?                     @map("posted_by_teacher_id") @db.Uuid
  updatedByUserId   String                      @map("updated_by_user_id")
  removedAt         DateTime?                   @map("removed_at")
  removedByUserId   String?                     @map("removed_by_user_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  batch           TrainingInstituteBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  postedByTeacher TrainingInstituteTeacher?     @relation(fields: [postedByTeacherId], references: [id], onDelete: Restrict)
  attachments     TrainingInstituteAttachment[]

  @@index([workspaceId, batchId, createdAt])
  @@map("study_materials")
  @@schema("training_institute")
}

/// Homework set for a Batch against one of its Class dates (ADR-0033).
model TrainingInstituteHomework {
  id                String                      @id @db.Uuid
  workspaceId       String                      @map("workspace_id")
  batchId           String                      @map("batch_id") @db.Uuid
  title             String                      @db.VarChar(200)
  instructions      String                      @db.Text
  classDate         DateTime                    @map("class_date") @db.Date
  dueOn             DateTime                    @map("due_on") @db.Date
  postedByUserId    String                      @map("posted_by_user_id")
  postedByRole      TrainingInstitutePosterRole @map("posted_by_role")
  postedByTeacherId String?                     @map("posted_by_teacher_id") @db.Uuid
  updatedByUserId   String                      @map("updated_by_user_id")
  removedAt         DateTime?                   @map("removed_at")
  removedByUserId   String?                     @map("removed_by_user_id")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  batch           TrainingInstituteBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  postedByTeacher TrainingInstituteTeacher?             @relation(fields: [postedByTeacherId], references: [id], onDelete: Restrict)
  submissions     TrainingInstituteHomeworkSubmission[]
  attachments     TrainingInstituteAttachment[]

  @@index([workspaceId, batchId, createdAt])
  @@map("homework")
  @@schema("training_institute")
}

/// A Student's Homework marked done by the Student or a linked Parent. One
/// live Submission per Homework and Student (partial unique index in the
/// migration); an undone Submission stays with withdrawn_at set.
model TrainingInstituteHomeworkSubmission {
  id                String                         @id @db.Uuid
  workspaceId       String                         @map("workspace_id")
  homeworkId        String                         @map("homework_id") @db.Uuid
  studentId         String                         @map("student_id") @db.Uuid
  note              String?                        @db.VarChar(1000)
  submittedAt       DateTime                       @map("submitted_at")
  submittedByUserId String                         @map("submitted_by_user_id")
  submittedByRole   TrainingInstituteSubmitterRole @map("submitted_by_role")
  updatedByUserId   String                         @map("updated_by_user_id")
  updatedByRole     TrainingInstituteSubmitterRole @map("updated_by_role")
  checkedAt         DateTime?                      @map("checked_at")
  checkedByUserId   String?                        @map("checked_by_user_id")
  remark            String?                        @db.VarChar(500)
  withdrawnAt       DateTime?                      @map("withdrawn_at")
  withdrawnByUserId String?                        @map("withdrawn_by_user_id")
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")

  homework    TrainingInstituteHomework     @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  student     TrainingInstituteStudent      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attachments TrainingInstituteAttachment[]

  @@index([workspaceId, homeworkId])
  @@index([workspaceId, studentId])
  @@map("homework_submissions")
  @@schema("training_institute")
}

/// A PDF, JPEG, or PNG on at most one Study Material, Homework, or Submission
/// (check constraint in the migration). An upload with none is waiting to be
/// attached by the User who sent it; unattached uploads are purged after a day.
model TrainingInstituteAttachment {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id")
  studyMaterialId  String?   @map("study_material_id") @db.Uuid
  homeworkId       String?   @map("homework_id") @db.Uuid
  submissionId     String?   @map("submission_id") @db.Uuid
  name             String    @db.VarChar(200)
  mimeType         String    @map("mime_type") @db.VarChar(50)
  sizeBytes        Int       @map("size_bytes")
  data             Bytes
  uploadedByUserId String    @map("uploaded_by_user_id")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  deletedAt        DateTime? @map("deleted_at")
  deletedByUserId  String?   @map("deleted_by_user_id")

  studyMaterial TrainingInstituteStudyMaterial?      @relation(fields: [studyMaterialId], references: [id], onDelete: Restrict)
  homework      TrainingInstituteHomework?           @relation(fields: [homeworkId], references: [id], onDelete: Restrict)
  submission    TrainingInstituteHomeworkSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([studyMaterialId, deletedAt])
  @@index([homeworkId, deletedAt])
  @@index([submissionId, deletedAt])
  @@index([workspaceId, uploadedByUserId, uploadedAt])
  @@map("attachments")
  @@schema("training_institute")
}

enum TrainingInstituteClassTestScope {
  batch
  student

  @@map("class_test_scope")
  @@schema("training_institute")
}

enum TrainingInstituteTestResultStatus {
  scored
  absent
  exempt

  @@map("test_result_status")
  @@schema("training_institute")
}

/// A Test for a whole Batch or for one Student in it (ADR-0037). Results stay
/// hidden from Students and Parents until published_at is set.
model TrainingInstituteClassTest {
  id                 String                          @id @db.Uuid
  workspaceId        String                          @map("workspace_id")
  batchId            String                          @map("batch_id") @db.Uuid
  scope              TrainingInstituteClassTestScope
  /// The Student a single-student Test is for; null for a whole-batch Test.
  studentId          String?                         @map("student_id") @db.Uuid
  name               String                          @db.VarChar(200)
  heldOn             DateTime                        @map("held_on") @db.Date
  maxMarks           Int                             @map("max_marks")
  passMarks          Int?                            @map("pass_marks")
  topic              String?                         @db.VarChar(1000)
  createdByUserId    String                          @map("created_by_user_id")
  createdByRole      TrainingInstitutePosterRole     @map("created_by_role")
  createdByTeacherId String?                         @map("created_by_teacher_id") @db.Uuid
  updatedByUserId    String                          @map("updated_by_user_id")
  publishedAt        DateTime?                       @map("published_at")
  publishedByUserId  String?                         @map("published_by_user_id")
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")
  deletedAt          DateTime?                       @map("deleted_at")
  deletedByUserId    String?                         @map("deleted_by_user_id")

  batch            TrainingInstituteBatch        @relation(fields: [batchId], references: [id], onDelete: Restrict)
  student          TrainingInstituteStudent?     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdByTeacher TrainingInstituteTeacher?     @relation(fields: [createdByTeacherId], references: [id], onDelete: Restrict)
  results          TrainingInstituteTestResult[]

  @@index([workspaceId, batchId, heldOn])
  @@map("class_tests")
  @@schema("training_institute")
}

/// One listed Student's result on a Test. A Student with no row is blank.
model TrainingInstituteTestResult {
  id              String                            @id @db.Uuid
  workspaceId     String                            @map("workspace_id")
  testId          String                            @map("test_id") @db.Uuid
  studentId       String                            @map("student_id") @db.Uuid
  status          TrainingInstituteTestResultStatus
  /// Half marks allowed; null unless scored.
  marks           Decimal?                          @db.Decimal(6, 1)
  remark          String?                           @db.VarChar(500)
  updatedByUserId String                            @map("updated_by_user_id")
  createdAt       DateTime                          @default(now()) @map("created_at")
  updatedAt       DateTime                          @updatedAt @map("updated_at")

  test    TrainingInstituteClassTest          @relation(fields: [testId], references: [id], onDelete: Restrict)
  student TrainingInstituteStudent            @relation(fields: [studentId], references: [id], onDelete: Restrict)
  changes TrainingInstituteTestResultChange[]

  @@unique([testId, studentId])
  @@index([workspaceId, studentId])
  @@map("test_results")
  @@schema("training_institute")
}

/// A change to a published result: old and new values, who, and when.
model TrainingInstituteTestResultChange {
  id                 String                            @id @db.Uuid
  workspaceId        String                            @map("workspace_id")
  resultId           String                            @map("result_id") @db.Uuid
  oldStatus          TrainingInstituteTestResultStatus @map("old_status")
  newStatus          TrainingInstituteTestResultStatus @map("new_status")
  oldMarks           Decimal?                          @map("old_marks") @db.Decimal(6, 1)
  newMarks           Decimal?                          @map("new_marks") @db.Decimal(6, 1)
  oldRemark          String?                           @map("old_remark") @db.VarChar(500)
  newRemark          String?                           @map("new_remark") @db.VarChar(500)
  changedByUserId    String                            @map("changed_by_user_id")
  changedByRole      TrainingInstitutePosterRole       @map("changed_by_role")
  changedByTeacherId String?                           @map("changed_by_teacher_id") @db.Uuid
  changedAt          DateTime                          @default(now()) @map("changed_at")

  result           TrainingInstituteTestResult @relation(fields: [resultId], references: [id], onDelete: Restrict)
  changedByTeacher TrainingInstituteTeacher?   @relation(fields: [changedByTeacherId], references: [id], onDelete: Restrict)

  @@index([resultId, changedAt])
  @@map("test_result_changes")
  @@schema("training_institute")
}
