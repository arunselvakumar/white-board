# Better Auth (ADR-0034). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public origin of Whiteboard, without /app. Vercel: the production domain.
BETTER_AUTH_URL=http://localhost:3000
# Optional: Google sign-in. Redirect URI: <BETTER_AUTH_URL>/app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: resend (production default), mailpit (docker compose), or log (prints
# codes and links to the server console; the development default).
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
EMAIL_FROM=Whiteboard <no-reply@example.com>
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5433/whiteboard
DATABASE_URL_TEST=postgresql://whiteboard:whiteboard@localhost:5433/whiteboard_test
# Generate with: openssl rand -base64 32
# Required to save Teacher ID numbers, bank account numbers, and private documents.
TEACHER_PRIVATE_DATA_KEY=

# Required for Whiteboard-hosted classes and private recordings.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_REALTIMEKIT_APP_ID=
CLOUDFLARE_REALTIMEKIT_API_TOKEN=
CLOUDFLARE_REALTIMEKIT_HOST_PRESET=
CLOUDFLARE_REALTIMEKIT_STUDENT_PRESET=
CLOUDFLARE_REALTIMEKIT_WEBHOOK_ID=
CLOUDFLARE_R2_RECORDINGS_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
