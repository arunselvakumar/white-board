# End-to-end tests (ADR CM-0031). Read by `bun run test:e2e:build` (next
# build) and by playwright.config.ts (next start). Test-only values: nothing
# here is a real secret.

# Its own database in the compose Postgres; global setup creates and migrates it.
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5433/construction_e2e?connection_limit=10

# A production build on its own port and build folder, so a developer's
# `next dev` on :3002 and its `.next` are left alone.
NEXT_DIST_DIR=.next-e2e
BETTER_AUTH_URL=http://localhost:3102
BETTER_AUTH_SECRET=e2e-tests-only-secret-0123456789abcdef
# A production build that is not live production: Mailpit email is allowed
# (as on a Vercel preview).
VERCEL_ENV=preview

# Every email lands in Mailpit (docker compose); tests read codes and links there.
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=Construction Management <no-reply@example.test>
SMS_TRANSPORT=log
AUTH_RATE_LIMIT=off

CONSTRUCTION_PRIVATE_DATA_KEY=ZTJlLXRlc3RzLW9ubHktcHJpdmF0ZS1kYXRhLWtleSE=
# Files on disk, never Vercel Blob.
BLOB_READ_WRITE_TOKEN=
BLOB_LOCAL_DIR=.blob-e2e

# Checkout against the in-process fake gateway (payment-gateway-from-env.ts).
RAZORPAY_KEY_ID=rzp_test_fake
RAZORPAY_KEY_SECRET=e2e-fake-key-secret
RAZORPAY_WEBHOOK_SECRET=e2e-webhook-secret
CONSTRUCTION_SELLER_STATE_CODE=33
CRON_SECRET=e2e-cron-secret
