# Construction Management (ADR CM-0001). Copy to .env and fill in.
# Its own database, `construction`, in the compose Postgres (docker compose up -d).
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5433/construction
# HTTP tests create and migrate this database themselves.
CONSTRUCTION_DATABASE_URL_TEST=postgresql://whiteboard:whiteboard@localhost:5433/construction_test

# Better Auth (root ADR-0034, CM-0002). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public origin of Construction Management.
BETTER_AUTH_URL=http://localhost:3002

# Email: resend (production default), mailpit (docker compose), or log (prints
# codes to the server console; the development default).
EMAIL_TRANSPORT=mailpit
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
EMAIL_FROM=Construction Management <no-reply@example.com>

# SMS for mobile OTP (CM-102): msg91 (production), log (prints codes to the
# server console; the development default), or outbox (tests).
SMS_TRANSPORT=log
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# DLT-approved invitation template with ##link##; without it invites are not texted.
MSG91_INVITE_TEMPLATE_ID=
# Development and tests only: this code is accepted for any mobile number.
# Never set it in production (the server refuses to start).
OTP_TEST_CODE=

# Files: Vercel Blob (private) in production, read-write token from the
# Blob store connected to the Vercel project. Without a token, development
# and tests keep files on disk under BLOB_LOCAL_DIR (ADR CM-0001).
BLOB_READ_WRITE_TOKEN=
BLOB_LOCAL_DIR=.blob-local

# Aadhaar and PAN of Team Members are stored encrypted (CM-108).
# Generate with: openssl rand -base64 32
CONSTRUCTION_PRIVATE_DATA_KEY=

# Subscription payments (CM-117). Use Razorpay TEST-MODE keys (rzp_test_…)
# outside production: test mode takes no money. Without the key id and
# secret the checkout shows "Payments are not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret set on the webhook (Dashboard → Webhooks) that posts
# payment.captured, order.paid and payment.failed to /api/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# The seller printed on subscription tax invoices. The state code decides
# CGST+SGST (buyer in the same state) or IGST; 27 is Maharashtra.
CONSTRUCTION_SELLER_NAME=
CONSTRUCTION_SELLER_ADDRESS=
CONSTRUCTION_SELLER_STATE_CODE=27
CONSTRUCTION_SELLER_GSTIN=
# SAC on the invoice (997331: licensing the right to use software).
CONSTRUCTION_SELLER_SAC=997331
