{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_TEST",
    "CONSTRUCTION_DATABASE_URL_TEST",
    "DATABASE_URL_ADMIN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_WHITEBOARD_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "EMAIL_TRANSPORT",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "MAILPIT_URL",
    "AUTH_RATE_LIMIT",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "NODE_ENV",
    "TEACHER_PRIVATE_DATA_KEY",
    "CLOUDFLARE_ACCOUNT_ID",
    "CLOUDFLARE_REALTIMEKIT_APP_ID",
    "CLOUDFLARE_REALTIMEKIT_API_TOKEN",
    "CLOUDFLARE_REALTIMEKIT_HOST_PRESET",
    "CLOUDFLARE_REALTIMEKIT_STUDENT_PRESET",
    "CLOUDFLARE_REALTIMEKIT_WEBHOOK_ID",
    "CLOUDFLARE_R2_RECORDINGS_BUCKET",
    "CLOUDFLARE_R2_ACCESS_KEY_ID",
    "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
    "CONSTRUCTION_SMS",
    "SMS_TRANSPORT",
    "MSG91_AUTH_KEY",
    "MSG91_TEMPLATE_ID",
    "OTP_TEST_CODE",
    "NEXT_DIST_DIR",
    "CONSTRUCTION_PRIVATE_DATA_KEY",
    "MSG91_INVITE_TEMPLATE_ID",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_LOCAL_DIR",
    "RAZORPAY_KEY_ID",
    "RAZORPAY_KEY_SECRET",
    "RAZORPAY_WEBHOOK_SECRET",
    "CONSTRUCTION_SELLER_NAME",
    "CONSTRUCTION_SELLER_ADDRESS",
    "CONSTRUCTION_SELLER_STATE_CODE",
    "CONSTRUCTION_SELLER_GSTIN",
    "CONSTRUCTION_SELLER_SAC",
    "NEXT_PHASE",
    "BLOB_STORE_ID",
    "VERCEL_ENV"
  ],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^generate"]
    },
    "test": {
      "dependsOn": ["^generate"]
    },
    "test:http": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "outputs": ["storybook-static/**"]
    },
    "test-storybook": {
      "cache": false
    }
  }
}
