{
  "name": "white-board-v3",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev storybook",
    "start": "turbo run dev storybook",
    "generate": "turbo run generate",
    "test": "turbo run test",
    "test:http": "turbo run test:http",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "check-types": "turbo run check-types",
    "check-versions": "check-dependency-version-consistency --dep-type=dependencies,devDependencies,optionalDependencies,peerDependencies,resolutions .",
    "ci": "bun run check-versions && bun run format:check && bun run lint && bun run check-types && bun run test && bun run test:http && bun run build && bun run test-storybook",
    "storybook": "turbo run storybook --filter=whiteboard",
    "build-storybook": "turbo run build-storybook --filter=whiteboard",
    "test-storybook": "turbo run test-storybook --filter=whiteboard"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "check-dependency-version-consistency": "^6.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
